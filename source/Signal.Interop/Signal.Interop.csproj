<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>..\..\dist</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    
    <!-- Idiomatic .NET Native Runtime Identifier detection -->
    <HostArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</HostArchitecture>
    <NativeRid Condition="$([MSBuild]::IsOsPlatform('Windows'))">win-$(HostArchitecture)</NativeRid>
    <NativeRid Condition="$([MSBuild]::IsOsPlatform('Linux'))">linux-$(HostArchitecture)</NativeRid>
    <NativeRid Condition="$([MSBuild]::IsOsPlatform('OSX'))">osx-$(HostArchitecture)</NativeRid>
    <NativeRid Condition="'$(NativeRid)' == ''">win-x64</NativeRid>
  </PropertyGroup>

  <Target Name="BuildRustShim" BeforeTargets="PreBuildEvent">
    <Message Importance="High" Text="Building Rust signal_shim..." />
    <Exec Command="cargo build --release" WorkingDirectory="$(MSBuildProjectDirectory)\..\signal_shim" />
  </Target>

  <Target Name="CopyBuiltNativeLibrary" AfterTargets="BuildRustShim" BeforeTargets="PreBuildEvent;PrepareForBuild">
    <PropertyGroup>
      <BuiltNativeFile Condition="$([MSBuild]::IsOsPlatform('Windows'))">$(MSBuildProjectDirectory)\..\signal_shim\target\release\signal_shim.dll</BuiltNativeFile>
      <BuiltNativeFile Condition="$([MSBuild]::IsOsPlatform('Linux'))">$(MSBuildProjectDirectory)\..\signal_shim\target\release\libsignal_shim.so</BuiltNativeFile>
      <BuiltNativeFile Condition="$([MSBuild]::IsOsPlatform('OSX'))">$(MSBuildProjectDirectory)\..\signal_shim\target\release\libsignal_shim.dylib</BuiltNativeFile>
    </PropertyGroup>
    <Message Importance="High" Text="Deploying built native library to runtimes\$(NativeRid)\native..." Condition="Exists('$(BuiltNativeFile)')" />
    <Copy SourceFiles="$(BuiltNativeFile)" DestinationFolder="$(MSBuildProjectDirectory)\runtimes\$(NativeRid)\native" SkipUnchangedFiles="true" Condition="Exists('$(BuiltNativeFile)')" />
  </Target>

  <ItemGroup>
    <!-- Idiomatic .NET runtimes asset layout (copied to output and packaged into NuGet) -->
    <Content Include="runtimes\**\*" Exclude="runtimes\**\*.gitkeep" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes" />

    <None Include="readme.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
